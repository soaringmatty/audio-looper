{
  "name": "audio-looper",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "start": "ng serve --host localhost",
    "build": "node scripts/prepare-audio.mjs && ng build",
    "build:pages": "node scripts/prepare-audio.mjs && ng build --configuration production --base-href /audio-looper/",
    "soundbanks": "node scripts/fetch-soundbanks.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test": "yarn test:unit && yarn test:refactor",
    "audio:assets": "node scripts/prepare-audio.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"public/audio/{pcm-engine,input-fx,tap-calibration,pcm-processor}.{js,ts}\" \"public/audio/*.d.ts\" angular.json tsconfig*.json package.json",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"public/audio/{pcm-engine,input-fx,tap-calibration,pcm-processor}.{js,ts}\" \"public/audio/*.d.ts\" angular.json tsconfig*.json package.json",
    "test:refactor": "ng test --watch=false",
    "test:unit": "vitest run --exclude \"**/angular-refactor.test.ts\""
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "rxjs": "^7.8.2",
    "spessasynth_lib": "4.3.14",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "happy-dom": "20.8.4",
    "prettier": "3.8.1",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0"
  }
}
